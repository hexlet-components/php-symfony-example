{% extends 'base.html.twig' %}
{% block body %}<h1>Вход</h1>
{% if error %}<p role="alert">Неверные данные для входа</p>{% endif %}
<form method="post" action="{{ path('auth_login') }}">
<label>Email <input type="email" name="_username" value="{{ last_username }}" required></label>
<label>Пароль <input type="password" name="_password" required></label>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
<button>Войти</button></form>{% endblock %}
